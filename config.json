{
  "watch_folder": "%USERPROFILE%\\Downloads",
  "poll_interval_seconds": 4,
  "stability_checks": 2,
  "ignored_extensions": [".crdownload", ".tmp", ".part", ".download", ".partial"],
  "skip_names": ["desktop.ini"],
  "rules": [
    {"category": "Images", "extensions": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".svg", ".heic"]},
    {"category": "Documents", "extensions": [".pdf", ".doc", ".docx", ".txt", ".md", ".xlsx", ".xls", ".csv", ".ppt", ".pptx", ".odt"]},
    {"category": "Archives", "extensions": [".zip", ".rar", ".7z", ".tar", ".gz"]},
    {"category": "Installers", "extensions": [".exe", ".msi"]},
    {"category": "Videos", "extensions": [".mp4", ".mov", ".avi", ".mkv", ".webm"]},
    {"category": "Audio", "extensions": [".mp3", ".wav", ".flac", ".m4a"]}
  ]
}
